---
import { comunicadosData } from "../data/comunicados";
import ComunicadoCard from "./ComunicadoCard.astro";
---

<section class="bg-back py-16 sm:py-20 lg:py-28">
    <div class="container-page">
        <div
            class="flex flex-wrap items-end justify-between gap-6"
        >
            <div>
                <p
                    class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-red-light"
                >
                    <span
                        class="size-1.5 rounded-full bg-current"
                        aria-hidden="true"
                    ></span>
                    Comunicados
                </p>
                <div
                    class="mt-5 h-px w-12 bg-red-light"
                    aria-hidden="true"
                ></div>
            </div>
            <a
                href="#"
                class="inline-flex items-center gap-2 border border-red-light px-6 py-2.5 text-sm font-semibold uppercase tracking-wide text-red-light transition-colors duration-300 hover:bg-red-light hover:text-neutral-white"
            >
                Ver más comunicados
            </a>
        </div>

        <div
            class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8"
        >
            {
                comunicadosData.map((comunicado) => (
                    <ComunicadoCard comunicado={comunicado} />
                ))
            }
        </div>
    </div>
</section>