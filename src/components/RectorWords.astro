---


---

<section
    class="bg-neutral-white py-16 sm:py-20 lg:py-28"
>
    <div
        class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16"
    >
        <div>
            <p
                class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-red-light"
            >
                <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>
                Palabras del rector
            </p>

            <div
                class="mt-5 h-px w-12 bg-red-light"
                aria-hidden="true"
            ></div>

            <blockquote
                class="mt-8 border-l-2 border-red-light pl-6 text-lg font-light leading-relaxed text-fonts sm:text-xl lg:text-2xl"
            >
                <span aria-hidden="true">“</span>
                El posgrado representa el compromiso de nuestra universidad con
                la generación de conocimiento, la investigación y el desarrollo
                de Cusco y del Perú. Invitamos a los profesionales más
                talentosos a ser parte de este proyecto académico de excelencia.
                <span aria-hidden="true">”</span>
            </blockquote>

            <div class="mt-8">
                <p
                    class="text-lg font-semibold text-fonts"
                >
                    NOMBRE DEL RECTOR
                </p>
                <p
                    class="mt-1 text-sm uppercase tracking-[0.15em] text-neutral-light"
                >
                    Rector de la UNSAAC
                </p>
            </div>
        </div>

        <div class="relative mx-auto w-full max-w-sm lg:max-w-md">
            <div
                class="absolute -bottom-3 -left-3 h-full w-full border border-red-light"
                aria-hidden="true"
            ></div>
            <img
                src="/images/director-posgrado.jpg"
                alt="Retrato del rector de la Universidad Nacional de San Antonio Abad del Cusco"
                class="relative aspect-4/5 w-full bg-neutral-light object-cover"
            />
        </div>
    </div>
</section>