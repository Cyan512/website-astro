---
import FullMenuOverlay from "../navigation/FullMenuOverlay.astro";
import Menu from "@/assets/icons/menu.svg";
---

<header
    class="pointer-events-none fixed inset-0 z-40 flex flex-col justify-between p-4 md:p-6"
>
    <div class="grid grid-cols-[1fr_auto_1fr] items-start gap-4">
        <div class="pointer-events-auto relative">
            <button
                type="button"
                id="open-menu-btn"
                aria-label="Abrir menú de navegación"
                class="menu-toggle flex items-stretch gap-0.5"
            >
                <span
                    class="grid size-12 shrink-0 place-items-center rounded-full pill"
                >
                    <Menu />
                </span>
                <span
                    class="hidden h-12 w-30.5 items-center gap-1.25 px-4 font-display text-title-small uppercase tracking-wide sm:flex pill"
                >
                    <span
                        class="size-1.5 shrink-0 rounded-full bg-current"
                        aria-hidden="true"></span>
                    <span>Menu</span>
                </span>
            </button>
        </div>
        <div class="flex items-center justify-center">
            <a href="/" class="flex items-center gap-3 group">
                <div class="flex items-center gap-2.5">
                    <svg
                        class="w-8 h-8 sm:w-9 sm:h-9 text-amber-500 shrink-0"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4l7 3.82 7-3.82v-4L12 17l-7-3.82z"
                        ></path>
                    </svg>
                    <div class="text-left leading-tight hidden xs:block">
                        <span
                            class="block text-xs font-bold tracking-widest uppercase text-white"
                            >Escuela de</span
                        >
                        <span
                            class="block text-xs font-bold tracking-widest uppercase text-amber-500"
                            >Posgrado UNSAAC</span
                        >
                    </div>
                </div>
            </a>
        </div>
        <div class="flex justify-end">
            <button
                type="button"
                class="p-2 text-white hover:text-amber-500 hover:bg-white/10 rounded-full transition-all cursor-pointer focus:outline-none"
                aria-label="Buscar"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </button>
        </div>
    </div>
</header>
<FullMenuOverlay />

<style>
    .menu-toggle:hover [data-menu-part],
    .menu-toggle:focus-visible [data-menu-part] {
        background-color: color-mix(
            in oklab,
            var(--color-neutral-dark) 80%,
            transparent
        );
    }
</style>
